GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- Vertex AI (alternativa ao AI Studio; tem precedência quando setado) ---
# GOOGLE_CLOUD_PROJECT=           # número ou ID do projeto GCP
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_VERTEX_API_VERSION=v1    # v1beta1 não responde no endpoint global
# GOOGLE_SERVICE_ACCOUNT_JSON=    # JSON da service account (uma linha)
# GEMINI_MODEL=gemini-3.5-flash    # modelos 3.5/4 do catalogo Vertex do projeto
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# --- ElevenLabs (ligações por voz na Academia) ---
ELEVENLABS_API_KEY=        # elevenlabs.io → Profile → API Keys
ELEVENLABS_VOICE_ID=       # opcional — ID da voz (padrão: Roger, multilingual)

# --- WhatsApp via QR (serviço wa-server/ no Railway) ---
# No Netlify (app Next.js):
WA_SERVICE_URL=           # URL pública do serviço Railway, ex: https://wa-server-production-xxxx.up.railway.app
WA_SERVICE_SECRET=        # segredo compartilhado app <-> wa-server (mesmo valor nos dois lados)
# No Railway (wa-server):
WA_SERVICE_SECRET=        # mesmo segredo acima
APP_WEBHOOK_URL=https://fqimoveis.netlify.app/api/webhooks/wa-session
# AUTH_DIR=/data/auth     # opcional: default usa /data/auth se o volume existir
